# --- Service ---
# Async SQLAlchemy URL of the cache database.
CACHE_SERVICE_DATABASE_URL=sqlite+aiosqlite:///./data/cache.db
# Simulated latency of one call to the external transformer.
CACHE_SERVICE_TRANSFORMER_LATENCY_SECONDS=0.5
# Upper bound on concurrent calls to the external transformer.
CACHE_SERVICE_TRANSFORMER_MAX_CONCURRENCY=10
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
CACHE_SERVICE_LOG_LEVEL=INFO

# --- cache-cli ---
# Base URL of the cache service.
CACHE_CLI_HOST=http://localhost:8000
# Timeout of each HTTP request, in seconds.
CACHE_CLI_TIMEOUT_SECONDS=30
